#pragma kernel CSMain

StructuredBuffer<float4> _AllInstances;
AppendStructuredBuffer<float4> _VisibleInstances;

StructuredBuffer<float4> _Occluders;
int _OccluderCount;

float4x4 _VPMatrix;
float _MaxDistance;
float3 _CamPos;

// --- AJOUT : Variable pour forcer le rendu ---
int _RenderAll; 
int _DispatchStride;
// ---------------------------------------------

float RandomNoise(float2 pos)
{
    return frac(sin(dot(pos, float2(12.9898, 78.233))) * 43758.5453);
}

bool IsVisible(float3 pos)
{
    // --- AJOUT : Si on veut tout voir, on ignore les tests ---
    if (_RenderAll == 1)
        return true;
    // --------------------------------------------------------

    // 1. Distance Check (Caméra)
    if (distance(pos, _CamPos) > _MaxDistance)
        return false;

    // 2. Obstacle Check (Occluders)
    for (int i = 0; i < _OccluderCount; i++)
    {
        float4 occluder = _Occluders[i];
        float3 occPos = occluder.xyz;
        float radius = occluder.w;

        float dist = distance(pos.xz, occPos.xz);
        float noise = RandomNoise(pos.xz * 1.5); 
        float irregularRadius = radius * lerp(0.5, 1.0, noise);

        if (dist < irregularRadius)
            return false;
    }

    // 3. Frustum Check
    float4 clipPos = mul(_VPMatrix, float4(pos, 1.0));
    float margin = 1.5;
    bool inFrustum = (clipPos.x >= -clipPos.w - margin && clipPos.x <= clipPos.w + margin) &&
                     (clipPos.y >= -clipPos.w - margin && clipPos.y <= clipPos.w + margin) &&
                     (clipPos.z >= -clipPos.w && clipPos.z <= clipPos.w);

    return inFrustum;
}

[numthreads(64, 1, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint count, stride;
    _AllInstances.GetDimensions(count, stride);

    // --- MODIFICATION : Calcul de l'index 1D à partir de la grille 2D ---
    // On combine la position X et Y pour retrouver notre index linéaire
    uint index = id.x + id.y * _DispatchStride;
    // --------------------------------------------------------------------

    if (index >= count) return; // On utilise 'index' au lieu de 'id.x'

    // Utilise 'index' pour récupérer les données
    float4 instanceData = _AllInstances[index];
    
    if (IsVisible(instanceData.xyz))
    {
        _VisibleInstances.Append(instanceData);
    }
}