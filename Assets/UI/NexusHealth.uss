/* 1. Main Container alignment */
.hud-container {
    /* Change ceci pour inverser l'ordre visuel des enfants */
    flex-direction: row-reverse;
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
}

/* 2. The Wrapper for the Linear Bars */
.bars-wrapper {
    flex-direction: column;
    justify-content: center;

    /* CHANGEMENT 1 : On aligne les éléments au DÉBUT (Gauche) au lieu de la fin */
    align-items: flex-start;

    /* CHANGEMENT 2 : On tire vers la gauche pour passer sous le cercle, au lieu de la droite */
    margin-left: -30px;
    margin-right: 0; /* On réinitialise l'ancienne marge */

    z-index: 0;
}

/* 3. The Linear Track (Background of the bar) */
.linear-track {
    width: 250px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.5);
    margin-bottom: 5px; /* Spacing between up and down bars */

    /* KEY FOR EXPANDING LEFT: */
    /* We flip the flex direction so items start from the Right */
    flex-direction: row-reverse;

    /* Visual Styling */
    border-radius: 4px;
    overflow: hidden; /* Ensures fill stays inside rounded corners */
}

/* Optional: Add space between the two bars */
.top-bar {
    /* On met les arrondis à DROITE */
    border-top-right-radius: 24px;
    border-bottom-right-radius: 2px;

    /* On met le côté gauche (contre le cercle) à plat */
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;

    margin-bottom: 2px;
}

/* --- BARRE DU BAS --- */
.bottom-bar {
    /* On met les arrondis à DROITE */
    border-bottom-right-radius: 24px;
    border-top-right-radius: 2px;

    /* On met le côté gauche (contre le cercle) à plat */
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;

    margin-top: 2px;
}

/* 4. The Fill Element */
.linear-fill {
    height: 100%;
    width: 50%; /* This is what we animate in Code (0% to 100%) */

    /* Because parent is row-reverse, this anchors to the RIGHT */
    /* and grows towards the LEFT. */

    transition: width 0.2s ease-out; /* Smooth animation */
}

/* Colors */
.health-color { background-color: #FF4444; }
.mana-color { background-color: #4444FF; }

/* 5. The Radial Wrapper */
.radial-wrapper {
    width: 100px;
    height: 100px;
    justify-content: center;
    align-items: center;
    z-index: 1; /* Sit ON TOP of the bars */
}

/* The custom element size */
.radial-element {
    width: 100%;
    height: 100%;
}

.linear-track {
    width: 250px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 5px;

    /* CHANGEMENT : Revenir à la normale pour que le remplissage aille de Gauche -> Droite */
    flex-direction: row;

    overflow: hidden;
}

.top-bar {
    /* Round the Top-Left corner significantly */
    border-top-left-radius: 24px; /* Matches height for a perfect curve */

    /* Keep Bottom-Left sharp (or very slightly rounded) so it "connects" to the bottom bar */
    border-bottom-left-radius: 2px;

    /* The right side (touching the circle) stays flat */
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;

    margin-bottom: 2px; /* Tiny gap between bars looks stylish */
}

/* --- THE BOTTOM BAR (Mana) --- */
.bottom-bar {
    /* Round the Bottom-Left corner significantly */
    border-bottom-left-radius: 24px; /* Matches height */

    /* Keep Top-Left sharp to meet the top bar */
    border-top-left-radius: 2px;

    /* The right side (touching the circle) stays flat */
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;

    margin-top: 2px;
}