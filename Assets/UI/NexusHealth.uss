.hud-container {
    flex-direction: row-reverse;
    align-items: center;
    justify-content: flex-start;
    padding: 20px;
}

.bars-wrapper {
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    margin-left: -30px;
    margin-right: 0;
    z-index: 0;
}

.linear-track {
    width: 250px;
    height: 20px;
    background-color: rgba(0, 0, 0, 0.5);
    margin-bottom: 5px;
    flex-direction: row-reverse;
    border-radius: 4px;
    overflow: hidden;
}

.top-bar {
    border-top-right-radius: 24px;
    border-bottom-right-radius: 2px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    margin-bottom: 2px;
}

.bottom-bar {
    border-bottom-right-radius: 24px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 0;
    border-top-left-radius: 0;
    margin-top: 2px;
}

.linear-fill {
    height: 100%;
    width: 50%;
    transition: width 0.2s ease-out;
}

.health-color {
    background-color: rgb(255, 68, 68);
}

.mana-color {
    background-color: rgb(68, 68, 255);
}

.radial-wrapper {
    width: 100px;
    height: 100px;
    justify-content: center;
    align-items: center;
    z-index: 1;
}

.radial-element {
    width: 100%;
    height: 100%;
}

.resource-icon {
    /* Set the size of your icon */
    width: 20px;
    height: 20px;

    /* Adds space between the number and the icon */
    margin-left: 5px;

    /* Assign your Scraps PNG here */
    background-image: url("project:/Assets/UI/Textures/Icon_Scraps.png");

    /* Keeps the aspect ratio correct */
    -unity-background-scale-mode: scale-to-fit;
}

.linear-track {
    width: 250px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0.6);
    margin-bottom: 5px;
    flex-direction: row;
    overflow: hidden;
}

.top-bar {
    border-top-left-radius: 24px;
    border-bottom-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    margin-bottom: 2px;
}

.bottom-bar {
    border-bottom-left-radius: 24px;
    border-top-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    margin-top: 2px;
}

.branch-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 151%;
    height: 870%;
    background-image: url("project://database/Assets/UI/UIAssets/UI_Vie_G_Barre_Deco%201.png?fileID=2800000&guid=acaf5abcddde32c429b1d694c70b93e4&type=3#UI_Vie_G_Barre_Deco 1");
    -unity-background-scale-mode: scale-and-crop;
    picking-mode: ignore;
    min-width: 0%;
}

.grunge-overlay {
    /* Covers the entire parent (the mask) */
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;

    /* Assign your grunge/stripe PNG here */
    background-image: url("project:/Assets/UI/Textures/Grunge_Stripes.png");

    /* Ensures the texture fills the space */
    -unity-background-scale-mode: scale-and-crop;

    /* Optional: Blend visual polish */
    opacity: 0.8; /* Adjust this to make the effect subtle or strong */
}

.linear-track {
    width: 250px;
    height: 24px;
    margin-bottom: 5px;
    flex-direction: row;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
}

.bar-mask {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
    flex-direction: row;
}
