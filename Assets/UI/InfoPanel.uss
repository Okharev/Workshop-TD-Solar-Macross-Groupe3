.side-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 350px;
    background-color: rgba(30, 30, 35, 0.95);
    border-right-width: 0;
    border-right-color: rgb(0, 0, 0);
    padding: 20px;
    translate: -100% 0;
    transition: translate 0.3s ease-out-cubic;
    border-left-width: 0;
    background-image: url("project://database/Assets/UI/UIAssets/UI_Vie_G_Back%201.png?fileID=2800000&guid=e0d7338f0fb412a46b3bb2d93914b9d2&type=3#UI_Vie_G_Back 1");
    padding-top: 33px;
    padding-right: 33px;
    padding-bottom: 33px;
    padding-left: 33px;
    height: auto;
    min-height: 350px;
}

.side-panel--open {
    translate: 0 0;
}

.panel-header {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/space%20Xrebron.ttf?fileID=12800000&guid=07da749f81306ef4ab98e07a2320e5c6&type=3#space Xrebron");
}

.panel-description {
    font-size: 14px;
    color: rgb(255, 255, 255);
    white-space: normal;
    margin-bottom: 15px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/Nunito-VariableFont_wght.ttf?fileID=12800000&guid=6fe7d516eb36ebe4982d4b41197302b1&type=3#Nunito-VariableFont_wght");
}

.divider {
    height: 1px;
    background-color: rgb(255, 255, 255);
    margin-bottom: 15px;
    color: rgb(255, 255, 255);
}

.stats-container {
    flex-grow: 1;
    margin-bottom: 20px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/Nunito-VariableFont_wght.ttf?fileID=12800000&guid=6fe7d516eb36ebe4982d4b41197302b1&type=3#Nunito-VariableFont_wght");
}

.actions-container {
    flex-direction: column;
    justify-content: flex-end;
}

.action-item-container {
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 6px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.1);
}

.action-button {
    height: 35px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(79, 140, 126);
    border-radius: 4px;
    border-width: 0;
    margin-bottom: 4px;
    transition: background-color 0.1s;
}

.action-button:hover {
    background-color: rgb(170, 240, 225);
}

.action-button:active {
    background-color: rgb(126, 174, 164);
}

.action-button--disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(150, 150, 150);
    cursor: default;
}

.action-description {
    font-size: 11px;
    color: rgb(200, 200, 200);
    white-space: normal;
    -unity-font-style: italic;
    padding-left: 2px;
}

.button-menu {
    background-color: rgba(170, 240, 225, 0.5);
    border-top-left-radius: 52px;
    border-top-right-radius: 52px;
    border-bottom-right-radius: 52px;
    border-bottom-left-radius: 52px;
    font-size: 58px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/space%20Xrebron.ttf?fileID=12800000&guid=07da749f81306ef4ab98e07a2320e5c6&type=3#space Xrebron");
    -unity-text-align: upper-left;
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 30px;
    padding-right: 30px;
    margin-bottom: 30px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgb(98, 130, 123);
    border-right-color: rgb(98, 130, 123);
    border-top-color: rgb(98, 130, 123);
    border-bottom-color: rgb(98, 130, 123);
    background-image: none;
    background-position-x: right 0;
    background-position-y: bottom 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-slice-type: sliced;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
}
