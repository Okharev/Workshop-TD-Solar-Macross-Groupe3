.side-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 350px;
    background-color: rgba(30, 30, 35, 0.95);
    border-right-width: 2px;
    border-right-color: rgb(76, 175, 80);
    padding: 20px;
    translate: -100% 0;
    transition: translate 0.3s ease-out-cubic;
    border-left-width: 2px;
}

.side-panel--open {
    translate: 0 0;
}

.panel-header {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 5px;
}

.panel-description {
    font-size: 14px;
    color: rgb(170, 170, 170);
    white-space: normal;
    margin-bottom: 15px;
}

.divider {
    height: 1px;
    background-color: rgb(85, 85, 85);
    margin-bottom: 15px;
}

.stats-container {
    flex-grow: 1;
    margin-bottom: 20px;
}

.actions-container {
    flex-direction: column;
    justify-content: flex-end;
}


.action-item-container {
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    padding: 6px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.1);
}

.action-button {
    height: 35px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(76, 175, 80);
    border-radius: 4px;
    border-width: 0;
    margin-bottom: 4px;
    transition: background-color 0.1s;
}

.action-button:hover {
    background-color: rgb(100, 200, 100);
}

.action-button:active {
    background-color: rgb(50, 150, 50);
}

/* État désactivé (gris) */
.action-button--disabled {
    background-color: rgb(60, 60, 60);
    color: rgb(150, 150, 150);
    cursor: default; /* Enlève le curseur main si supporté */
}

.action-description {
    font-size: 11px;
    color: rgb(200, 200, 200); /* Gris clair */
    white-space: normal; /* Permet le retour à la ligne */
    -unity-font-style: italic;
    padding-left: 2px;
}