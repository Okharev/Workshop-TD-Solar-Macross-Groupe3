@import url("project://database/Assets/UI/InfoPanel.uss?fileID=7433441132597879392&guid=b8383ba551774a218973a50334aae02a&type=3#InfoPanel");
@import url("project://database/Assets/UI/WavePanel.uss?fileID=7433441132597879392&guid=50b86e0e6c9f14b4e86674680b30ac56&type=3#WavePanel");
@import url("project://database/Assets/UI/ObjectivesHealthPanel.uss?fileID=7433441132597879392&guid=a7eb2283b8f842d0aebcfd2460187d89&type=3#ObjectivesHealthPanel");
@import url("project://database/Assets/UI/BuildingBarPanel.uss?fileID=7433441132597879392&guid=a0d596e7938443a8a478da3fca5785a9&type=3#BuildingBarPanel");
:root {
    --color-bg: rgba(30, 30, 35, 0.95);
    --color-border: rgb(62, 62, 66);
    --color-accent: rgb(76, 175, 80);
    --color-text-main: rgb(224, 224, 224);
    --color-text-sub: rgb(160, 160, 160);
    --sidebar-width-left: 150px;
    --sidebar-width-right: 220px;
    --panel-radius: 6px;
    --spacing-std: 10px;
}

.hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    font-size: 12px;
    color: var(--color-text-main);
}

.minimap-wrapper {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 200px;
    height: 200px;
    overflow: visible;
}

.minimap-mask {
    width: 100%;
    height: 100%;
    background-color: rgb(20, 20, 20);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    overflow: hidden;
}

.minimap-border {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 120%;
    height: 120%;
    background-image: url("project://database/Assets/UI/UIAssets/UI_MicroMap.png?fileID=2800000&guid=16fb1acc7c92f07459380590a0f307e9&type=3#UI_MicroMap");
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
    border-top-width: 228px;
    border-right-width: 228px;
    border-bottom-width: 228px;
    border-left-width: 228px;
}

.left-sidebar {
    position: absolute;
    left: 15px;
    top: 15px;
    bottom: 15px;
    width: var(--sidebar-width-left);
    flex-direction: column;
    align-items: stretch;
}

.left-sidebar .panel-container {
    position: relative;
    top: auto;
    left: auto;
    width: 100%;
    background-color: var(--color-bg);
    border-radius: var(--panel-radius);
    border-left-width: 3px;
    border-left-color: var(--color-accent);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--color-border);
    padding: var(--spacing-std);
    margin-bottom: 10px;
    flex-shrink: 0;
}

.left-sidebar .status-text {
    font-size: 10px;
    color: var(--color-text-sub);
    margin-bottom: 2px;
}

.left-sidebar .title-text {
    font-size: 18px;
    margin-bottom: 0;
}

.left-sidebar .subtitle-text {
    font-size: 11px;
    margin-bottom: 8px;
}

.objectives-box {
    position: relative;
    background-color: var(--color-bg);
    border-radius: var(--panel-radius);
    padding: var(--spacing-std);
    border-width: 1px;
    border-color: var(--color-border);
    border-top-width: 3px;
    border-top-color: rgb(85, 85, 85);
    flex-shrink: 0;
}

.objectives-box .header-label {
    font-size: 11px;
    color: var(--color-text-sub);
    border-bottom-width: 0;
    margin-bottom: 8px;
    text-transform: uppercase;
    opacity: 0.8;
}

.objectives-box .health-label {
    font-size: 11px;
    margin-bottom: 2px;
}

.objectives-box .health-row {
    margin-bottom: 6px;
}

.objectives-box .health-bar-container {
    height: 6px;
    border-radius: 2px;
    background-color: rgb(34, 34, 34);
}

#BuildingBarInstance {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    width: auto;
    height: auto;
    align-items: center;
    justify-content: flex-end;
}

.right-sidebar {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 320px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 20px;
    overflow: hidden;
}

.right-sidebar .side-panel {
    position: relative;
    top: auto;
    left: auto;
    bottom: auto;
    width: 100%;
    height: auto;
    background-color: var(--color-bg);
    padding: 15px;
    border-width: 1px;
    border-color: var(--color-border);
    border-left-width: 0;
    border-left-color: var(--color-accent);
    border-radius: var(--panel-radius);
    translate: 120% 0;
    transition: translate 0.25s ease-out-cubic;
    flex-shrink: 0;
}

.right-sidebar .side-panel--open {
    translate: 0 0;
}

.right-sidebar .panel-header {
    font-size: 20px;
    margin-bottom: 4px;
    color: white;
}

.right-sidebar .panel-description {
    font-size: 12px;
    margin-bottom: 10px;
    color: var(--color-text-sub);
}

.right-sidebar .stat-text {
    font-size: 11px;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 51);
}

.action-button {
    background-color: rgb(46, 204, 113);
    color: rgb(255, 255, 255);
    border-radius: 4px;
    padding: 10px;
    border-width: 0;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.action-button:hover {
    background-color: rgb(39, 174, 96);
    scale: 1.05;
}

.action-button:active {
    background-color: rgb(30, 132, 73);
    scale: 0.95;
}

.minimap-container {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 200px;
    height: 200px;
    background-color: rgb(20, 20, 20);
    border-width: 2px;
    border-color: rgb(100, 100, 100);
    border-radius: 10px;
    overflow: hidden;
}

.minimap-render {
    width: 100%;
    height: 100%;
    background-color: white;
}
