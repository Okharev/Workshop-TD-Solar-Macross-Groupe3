.fader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 3s;
    transition-timing-function: ease-in-out;
}

.fader--active {
    opacity: 1;
}

.button-menu {
    background-color: rgba(170, 240, 225, 0.5);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-right-radius: 34px;
    border-bottom-left-radius: 34px;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/space%20Xrebron.ttf?fileID=12800000&guid=07da749f81306ef4ab98e07a2320e5c6&type=3#space Xrebron");
    -unity-text-align: upper-left;
    padding-top: 19px;
    padding-bottom: 19px;
    padding-left: 19px;
    padding-right: 19px;
    margin-bottom: 6px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgb(98, 130, 123);
    border-right-color: rgb(98, 130, 123);
    border-top-color: rgb(98, 130, 123);
    border-bottom-color: rgb(98, 130, 123);
    background-image: none;
    background-position-x: right 0;
    background-position-y: bottom 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-slice-type: sliced;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    margin-top: 6px;
    margin-right: 6px;
    margin-left: 6px;
    transition-property: background-color;
}

.button-menu:hover {
    background-color: rgba(170, 240, 225, 0.5);
    border-top-left-radius: 34px;
    border-top-right-radius: 34px;
    border-bottom-right-radius: 34px;
    border-bottom-left-radius: 34px;
    font-size: 34px;
    -unity-font-definition: url("project://database/Assets/UI/UIAssets/space%20Xrebron.ttf?fileID=12800000&guid=07da749f81306ef4ab98e07a2320e5c6&type=3#space Xrebron");
    -unity-text-align: upper-left;
    padding-top: 19px;
    padding-bottom: 19px;
    padding-left: 19px;
    padding-right: 19px;
    margin-bottom: 6px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-left-color: rgb(133, 188, 176);
    border-right-color: rgb(133, 188, 176);
    border-top-color: rgb(133, 188, 176);
    border-bottom-color: rgb(133, 188, 176);
    background-image: none;
    background-position-x: right 0;
    background-position-y: bottom 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-slice-type: sliced;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    margin-top: 6px;
    margin-right: 6px;
    margin-left: 6px;
    transition-property: background-color;
}
