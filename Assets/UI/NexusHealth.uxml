<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/NexusHealth.uss?fileID=7433441132597879392&amp;guid=bbe5a8acdea6dfa4caf8da7ff17b6337&amp;type=3#NexusHealth" />
    <ui:VisualElement name="Linear-Bars-Wrapper" class="bars-wrapper" style="margin-left: 0; align-items: flex-start; width: 251px;">
        <ui:VisualElement style="flex-grow: 1; padding-top: 1px; padding-right: 1px; padding-bottom: 1px; padding-left: 1px; background-color: rgb(96, 144, 164); border-top-left-radius: 18px; border-top-right-radius: 18px; border-bottom-right-radius: 18px; border-bottom-left-radius: 18px; margin-bottom: 3px; align-items: auto; align-self: flex-end; color: rgb(255, 255, 255);">
            <ui:Label text="Nexus" style="-unity-font-definition: url(&quot;project://database/Assets/UI/UIAssets/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=6fe7d516eb36ebe4982d4b41197302b1&amp;type=3#Nunito-VariableFont_wght&quot;); -unity-font-style: bold; font-size: 24px; color: rgb(255, 255, 255);" />
        </ui:VisualElement>
        <ui:VisualElement name="Health-Bar-Track" class="linear-track" style="height: 30px;">
            <ui:VisualElement name="Bar-Mask" class="bar-mask top-bar">
                <ui:VisualElement name="Health-Fill" class="linear-fill health-color" />
                <ui:Image name="GrungeOverlay" picking-mode="Ignore" class="grunge-overlay" style="background-image: url(&quot;project://database/Assets/UI/UIAssets/UI_Vie_G_Vide.png?fileID=2800000&amp;guid=627045a9cfe93f54f8cf655476df8313&amp;type=3#UI_Vie_G_Vide&quot;); -unity-background-image-tint-color: rgba(255, 255, 255, 0.43);" />
            </ui:VisualElement>
            <ui:Image name="BranchOverlay" picking-mode="Ignore" class="branch-overlay" style="-unity-background-scale-mode: scale-to-fit; scale: 1 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
