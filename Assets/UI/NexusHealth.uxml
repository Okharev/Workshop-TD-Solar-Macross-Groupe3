<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/NexusHealth.uss?fileID=7433441132597879392&amp;guid=bbe5a8acdea6dfa4caf8da7ff17b6337&amp;type=3#NexusHealth" />
    <ui:VisualElement name="HUD-Container" class="hud-container">
        <ui:VisualElement name="Linear-Bars-Wrapper" class="bars-wrapper">
            <ui:VisualElement name="Health-Bar-Track" class="linear-track top-bar" style="height: 30px;">
                <ui:VisualElement name="Health-Fill" class="linear-fill health-color" />
            </ui:VisualElement>
            <ui:VisualElement name="Mana-Bar-Track" class="linear-track bottom-bar" style="height: 30px; -unity-text-align: upper-left; align-self: auto; align-items: auto; justify-content: center; -unity-font-definition: url(&quot;project://database/Assets/UI/UIAssets/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=6fe7d516eb36ebe4982d4b41197302b1&amp;type=3#Nunito-VariableFont_wght&quot;);">
                <ui:Label text="100&#10;" name="Amount" style="-unity-text-align: upper-left; color: rgb(230, 230, 230); font-size: 18px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; -unity-font-style: bold;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="currentMoney._value" data-source-type="Economy.CurrencyManager, Assembly-CSharp" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Radial-Wrapper" class="radial-wrapper">
            <UI.RadialProgress line-width="25" progress="100" name="NexusHealth" style="height: 89px; background-size: 100px 100px; width: 94px;">
                <Bindings>
                    <ui:DataBinding property="Progress" data-source-path="currentHealth._value" data-source-type="Enemy.HealthComponent, Assembly-CSharp" binding-mode="ToTarget" />
                    <ui:DataBinding property="MaxValue" data-source-path="maxHealth" data-source-type="Enemy.HealthComponent, Assembly-CSharp" binding-mode="ToTarget" />
                    <ui:DataBinding property="CurrentValue" data-source-path="currentHealth._value" data-source-type="Enemy.HealthComponent, Assembly-CSharp" binding-mode="ToTarget" />
                </Bindings>
            </UI.RadialProgress>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
